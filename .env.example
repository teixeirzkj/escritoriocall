# =============================================================================
# Andar — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# NUNCA coloque chaves secretas em variáveis NEXT_PUBLIC_*.
# =============================================================================

# URL pública do site (usada em links de e-mail). Em produção: https://seu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública ("publishable", sb_publishable_...). A chave "anon" legada também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta ("secret", sb_secret_...) ou "service_role" legada. SOMENTE servidor.
# Usada para: listar e-mails, promover administradores e excluir contas.
SUPABASE_SECRET_KEY=

# --- Ably (app → API Keys) — presença, movimento e chat em tempo real --------
# Use a chave com capacidades "publish, subscribe, presence". SOMENTE servidor.
ABLY_API_KEY=

# --- LiveKit Cloud (Project → Settings → Keys) — áudio, vídeo e tela ---------
# Ex.: wss://seu-projeto.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
